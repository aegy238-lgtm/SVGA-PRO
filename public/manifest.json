{
  "id": "/",
  "name": "AHMED & CR8 SVGA · MotionTools",
  "short_name": "Ahmed SVGA",
  "description": "تطبيق معالجة وتشغيل وتحويل ملفات الحركة والهدايا SVGA, VAP, YYEVA, PAG, Lottie, MP4, GIF, WebP, APNG على الويندوز والموبايل.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "theme_color": "#0b0b14",
  "background_color": "#07070c",
  "lang": "ar",
  "dir": "rtl",
  "categories": ["photo", "video", "graphics", "utilities", "productivity"],
  "launch_handler": {
    "client_mode": ["focus-existing", "navigate-existing", "auto"]
  },
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "معالجة وتحويل الملفات",
      "short_name": "فتح ملف",
      "description": "فتح وتشغيل ملفات SVGA والهدايا والرسوم المتحركة فوراً",
      "url": "/?action=open_file",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "محرر طبقات SVGA",
      "short_name": "محرر SVGA",
      "description": "تشغيل محرر طبقات الرسوم المتحركة المتقدم",
      "url": "/?action=editor",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "استوديو عرض ملفات الهدايا",
      "short_name": "ملفات الهدايا",
      "description": "معاينة جماعية لملفات SVGA و PAG و VAP",
      "url": "/?action=gifts",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/?file_launch=1",
      "name": "AHMED & CR8 SVGA Animation",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        },
        {
          "src": "/pwa-512x512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/x-svga": [".svga"]
      }
    },
    {
      "action": "/?file_launch=1",
      "name": "AHMED & CR8 Motion & Media Files",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        },
        {
          "src": "/pwa-512x512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/x-vap": [".vap"],
        "application/x-yyeva": [".yyeva"],
        "application/x-pag": [".pag"],
        "application/x-lottie": [".lottie"],
        "application/x-dotlottie": [".dotlottie"],
        "application/x-motiontools": [".motiontools"],
        "application/zip": [".zip"],
        "application/json": [".json"],
        "video/mp4": [".mp4"],
        "video/webm": [".webm"],
        "video/quicktime": [".mov"],
        "image/gif": [".gif"],
        "image/webp": [".webp"],
        "image/apng": [".apng"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/svg+xml": [".svg"]
      }
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "mediaFiles",
          "accept": [
            "image/*",
            "video/*",
            "application/json",
            "application/zip",
            "application/octet-stream",
            ".svga",
            ".vap",
            ".yyeva",
            ".pag",
            ".lottie",
            ".dotlottie",
            ".motiontools",
            ".svg",
            ".mp4",
            ".mov",
            ".webm",
            ".webp",
            ".gif",
            ".apng",
            ".png",
            ".jpg",
            ".jpeg",
            ".json",
            ".zip"
          ]
        }
      ]
    }
  }
}
