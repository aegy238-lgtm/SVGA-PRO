{
  "name": "motiontools",
  "private": true,
  "version": "1.0.0",
  "description": "MotionTools SVGA Pro - Desktop & Web studio for previewing, editing, compressing, and converting SVGA, VAP, YYEVA, PAG, Lottie, GIF, WebP, APNG, and MP4.",
  "author": "MotionTools Studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/codecs.test.ts",
    "electron:start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist:win:portable": "npm run build && electron-builder --win portable --config electron-builder.yml"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jszip": "^3.4.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "jszip": "^3.10.2",
    "libpag": "^4.4.76",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pako": "^3.0.3",
    "protobufjs": "^8.8.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "svg-pathdata": "^9.0.0",
    "svga.lite": "^1.6.1",
    "upng-js": "^2.1.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
